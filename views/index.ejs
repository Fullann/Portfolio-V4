<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= siteName %> | <%= formattedPersonalInfo.title || 'Portfolio' %></title>
    <meta
      name="description"
      content="<%= siteDesc %>"
    />
    <link rel="canonical" href="<%= baseUrl %>/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="<%= siteName %>" />
    <meta property="og:title" content="<%= formattedPersonalInfo.name %> | <%= formattedPersonalInfo.title || 'Portfolio' %>" />
    <meta
      property="og:description"
      content="<%= siteDesc %>"
    />
    <meta property="og:url" content="<%= baseUrl %>/" />
    <meta property="og:image" content="<%= avatarUrl %>" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= formattedPersonalInfo.name %> | <%= formattedPersonalInfo.title || 'Portfolio' %>" />
    <meta
      name="twitter:description"
      content="<%= siteDesc %>"
    />
    <meta
      name="twitter:image"
      content="<%= avatarUrl %>"
    />
    
    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="<%= siteName %> - Flux RSS" href="/rss.xml" />

    <!--
    - favicon
  -->
    <link
      rel="shortcut icon"
      href="/assets/images/icon.ico"
      type="image/x-icon"
    />
    <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
    <!--
    - custom css link
  -->
    <link rel="stylesheet" href="./assets/css/style.css?v=<%= version %>" />

    <!--
    - google font link
  -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
    /></noscript>

  </head>

  <body>
    <!--
    - #MAIN
  -->
    <div class="header-controls">
      <div class="lang-selector" id="lang-selector"></div>
      <div class="theme-toggle">
        <button
          id="theme-toggle-btn"
          class="theme-toggle-btn"
          aria-label="Basculer le thème"
        >
          <ion-icon name="sunny-outline" class="light-icon"></ion-icon>
          <ion-icon name="moon-outline" class="dark-icon"></ion-icon>
        </button>
      </div>
    </div>
    <main>
      <!--
      - #SIDEBAR
    -->

      <aside class="sidebar" data-sidebar>
        <div class="sidebar-info">
          <figure class="avatar-box">
            <img
              src="<%= formattedPersonalInfo.avatar || './assets/images/my-avatar.png' %>"
              alt="<%= formattedPersonalInfo.name %>"
              width="80"
              data-avatar-img
            />
          </figure>

          <div class="info-content">
            <h1 class="name" title="<%= formattedPersonalInfo.name %>" data-name>
              <%= formattedPersonalInfo.name %>
            </h1>

            <p class="title" data-title data-i18n="personal.title"><%= formattedPersonalInfo.title %></p>
          </div>

          <button class="info_more-btn" data-sidebar-btn>
            <span data-i18n="sidebar.contacts_show">Afficher les contacts</span>
            <ion-icon name="chevron-down"></ion-icon>
          </button>
        </div>

        <div class="sidebar-info_more">
          <div class="separator"></div>

          <ul class="contacts-list">
            <% if (formattedPersonalInfo.email) { %>
            <li class="contact-item">
              <div class="icon-box">
                <ion-icon name="mail-outline"></ion-icon>
              </div>

              <div class="contact-info">
                <p class="contact-title" data-i18n="sidebar.email">Email</p>

                <a
                  href="mailto:<%= formattedPersonalInfo.email %>"
                  class="contact-link"
                  data-contact-email
                  ><%= formattedPersonalInfo.email %></a
                >
              </div>
            </li>
            <% } %>

            <% if (formattedPersonalInfo.phone) { %>
            <li class="contact-item">
              <div class="icon-box">
                <ion-icon name="phone-portrait-outline"></ion-icon>
              </div>

              <div class="contact-info">
                <p class="contact-title" data-i18n="sidebar.phone">Téléphone</p>

                <a
                  href="tel:<%= formattedPersonalInfo.phone %>"
                  class="contact-link"
                  data-contact-phone
                  ><%= formattedPersonalInfo.phone %></a
                >
              </div>
            </li>
            <% } %>

            <% if (formattedPersonalInfo.birthday) { %>
            <li class="contact-item">
              <div class="icon-box">
                <ion-icon name="calendar-outline"></ion-icon>
              </div>

              <div class="contact-info">
                <p class="contact-title" data-i18n="sidebar.birthday">Date de naissance</p>

                <time datetime="<%= formattedPersonalInfo.birthday %>" data-contact-birthday
                  ><%= formattedPersonalInfo.birthday %></time
                >
              </div>
            </li>
            <% } %>

            <% if (formattedPersonalInfo.location) { %>
            <li class="contact-item">
              <div class="icon-box">
                <ion-icon name="location-outline"></ion-icon>
              </div>

              <div class="contact-info">
                <p class="contact-title" data-i18n="sidebar.location">Localisation</p>

                <address data-contact-location>
                  <%= formattedPersonalInfo.location %>
                </address>
              </div>
            </li>
            <% } %>
          </ul>

          <div class="separator"></div>

          <ul class="social-list">
            <% for (let link of socialLinks) { %>
            <li class="social-item">
              <a href="<%= link.url %>" class="social-link" target="_blank" rel="noopener noreferrer">
                <ion-icon name="<%= link.icon %>"></ion-icon>
              </a>
            </li>
            <% } %>
          </ul>
        </div>
      </aside>

      <!--
      - #main-content
    -->

      <div class="main-content">
        <!--
        - #NAVBAR
      -->

        <!-- Navigation -->
        <nav class="navbar">
          <ul class="navbar-list">
            <li class="navbar-item">
              <button class="navbar-link active" data-nav-link data-nav-target="à propos" data-i18n="nav.about">À propos</button>
            </li>
            <li class="navbar-item">
              <button class="navbar-link" data-nav-link data-nav-target="parcours" data-i18n="nav.resume">Parcours</button>
            </li>
            <li class="navbar-item">
              <button class="navbar-link" data-nav-link data-nav-target="portfolio" data-i18n="nav.portfolio">Portfolio</button>
            </li>
            <li class="navbar-item">
              <button class="navbar-link" data-nav-link data-nav-target="blog" data-i18n="nav.blog">Blog</button>
            </li>
            <li class="navbar-item">
              <button class="navbar-link" data-nav-link data-nav-target="contact" data-i18n="nav.contact">Contact</button>
            </li>
          </ul>
        </nav>

        <!--
        - #ABOUT
      -->

        <article class="about active" data-page="à propos">
          <header>
            <h2 class="h2 article-title" data-i18n="nav.about">À propos</h2>
          </header>

          <section class="about-text" data-i18n-html="personal.about_text">
            <% if (formattedPersonalInfo.aboutText) { %>
              <% for (let paragraph of formattedPersonalInfo.aboutText) { %>
                <p><%= paragraph %></p>
              <% } %>
            <% } %>
            <p class="availability-badge" data-reveal data-i18n="about.availability">
              Disponible pour des mandats web freelance (sites vitrines, applications et maintenance).
            </p>
            <div class="cta-group" data-reveal>
              <button class="cta-primary" type="button" data-contact-cta data-i18n="about.cta_discuss">
                Discutons de ton projet
              </button>
              <button class="cta-secondary" type="button" data-portfolio-cta data-i18n="about.cta_view">
                Voir mes projets
              </button>
            </div>
          </section>

          <!--
          - service
        -->

          <section class="service">
            <h3 class="h3 service-title" data-i18n="about.working_on">Sur quoi je travaille actuellement</h3>
            <ul class="service-list">
              <% for (let project of heroProjects) { %>
              <li class="project-item active" data-filter-item data-category="<%= project.filterCategory || project.category %>">
                <a href="#" data-project-item>
                  <figure class="project-img">
                    <div class="project-item-icon-box">
                      <ion-icon name="eye-outline"></ion-icon>
                    </div>
                    <img src="<%= project.image || '/assets/images/project-1.jpg' %>" alt="<%= project.title %>" loading="lazy" data-project-image>
                  </figure>
                  <h3 class="project-title" data-project-title><%= project.title %></h3>
                  <p class="project-category" data-project-category><%= project.category %></p>
                  
                  <!-- Données cachées pour la modal -->
                  <div style="display: none;">
                    <span data-project-description><%= project.description || '' %></span>
                    <span data-project-repo-link><%= project.repoLink || '' %></span>
                    <span data-project-live-link><%= project.liveLink || '' %></span>
                  </div>
                </a>
              </li>
              <% } %>
            </ul>
          </section>

          <!--
          - testimonials
        -->

          <section class="testimonials">
            <h3 class="h3 testimonials-title" data-i18n="about.recommendations">Recommandations</h3>
            <ul class="testimonials-list has-scrollbar">
              <% for (let testimonial of testimonials) { %>
              <li class="testimonials-item">
                <div class="content-card" data-testimonials-item>
                  <figure class="testimonials-avatar-box">
                    <img src="<%= testimonial.avatar %>" alt="<%= testimonial.name %>" width="60" data-testimonials-avatar>
                  </figure>
                  <h4 class="h4 testimonials-item-title" data-testimonials-title><%= testimonial.name %></h4>
                  <div class="testimonials-text" data-testimonials-text>
                    <p><%= testimonial.text %></p>
                  </div>
                </div>
              </li>
              <% } %>
            </ul>
          </section>

          <!--
          - testimonials modal
        -->

          <div class="modal-container" data-modal-container>
            <div class="overlay" data-overlay></div>

            <section class="testimonials-modal">
              <button class="modal-close-btn" data-modal-close-btn>
                <ion-icon name="close-outline"></ion-icon>
              </button>

              <div class="modal-img-wrapper">
                <figure class="modal-avatar-box">
                  <img src="/madebyfullann.svg" alt="avatar box"
                  width="80" data-modal-img />
                </figure>

                <img src="./assets/images/icon-quote.svg" alt="quote icon" />
              </div>

              <div class="modal-content">
                <h4 class="h3 modal-title" data-modal-title>Témoignage</h4>

                <time datetime="">Date</time>

                <div data-modal-text>
                  <p>
                    Sélectionne un témoignage pour voir son contenu complet ici.
                  </p>
                </div>
              </div>
            </section>
          </div>

          <!--
          - clients
        -->

          <!-- clients -->
          <section class="clients">
            <h3 class="h3 clients-title" data-i18n="about.clients">Clients</h3>

            <ul class="clients-list has-scrollbar">
              <% for (let client of clients) { %>
              <li class="clients-item">
                <a href="<%= client.website || '#' %>" <%- client.website ? 'target="_blank" rel="noopener noreferrer"' : '' %>>
                  <img src="<%= client.logo %>" alt="<%= client.name %>" class="client-logo" loading="lazy">
                </a>
              </li>
              <% } %>
            </ul>
          </section>
        </article>

        <!--
        - #RESUME
      -->

        <article class="resume" data-page="parcours">
          <header>
            <h2 class="h2 article-title" data-i18n="nav.resume">Parcours</h2>
          </header>

          <section class="timeline">
            <div class="title-wrapper">
              <div class="icon-box">
                <ion-icon name="book-outline"></ion-icon>
              </div>
              <h3 class="h3" data-i18n="resume.education">Formations</h3>
            </div>

            <ol class="timeline-list">
              <% for (let edu of education) { %>
              <li class="timeline-item">
                <h4 class="h4 timeline-item-title"><%= edu.institution %></h4>
                <span><%= edu.period %></span>
                <p class="timeline-text"><%= edu.description %></p>
              </li>
              <% } %>
            </ol>
          </section>

          <section class="timeline">
            <div class="title-wrapper">
              <div class="icon-box">
                <ion-icon name="book-outline"></ion-icon>
              </div>
              <h3 class="h3" data-i18n="resume.experience">Expérience Professionnelle</h3>
            </div>

            <ol class="timeline-list">
              <% for (let exp of experience) { %>
              <li class="timeline-item">
                <h4 class="h4 timeline-item-title"><%= exp.position %></h4>
                <span><%= exp.period %></span>
                <p class="timeline-text"><%= exp.description %></p>
              </li>
              <% } %>
            </ol>
          </section>
          <section class="timeline">
            <div class="title-wrapper">
              <div class="icon-box">
                <ion-icon name="document-text-outline"></ion-icon>
              </div>
              <h3 class="h3" data-i18n="resume.cv">Mon CV</h3>
            </div>
            <div>
              <% if (formattedPersonalInfo.cvFile) { %>
              <div class="cv-container">
                  <div class="cv-preview">
                      <div class="cv-info">
                          <ion-icon name="document-text-outline"></ion-icon>
                          <div class="cv-details">
                              <h4>Télécharger mon CV</h4>
                              <p>Consultez mon parcours complet au format PDF</p>
                          </div>
                      </div>
                      <div class="cv-actions">
                          <a href="<%= formattedPersonalInfo.cvFile %>" data-i18n-href="personal.cv_file" download class="cv-download-btn" target="_blank">
                              <ion-icon name="download-outline"></ion-icon>
                              <span>Télécharger PDF</span>
                          </a>
                          <button onclick="viewCVInline()" class="cv-view-btn">
                              <ion-icon name="eye-outline"></ion-icon>
                              <span>Aperçu</span>
                          </button>
                      </div>
                  </div>
                  <div id="cv-viewer" class="cv-viewer" style="display: none;">
                      <iframe src="<%= formattedPersonalInfo.cvFile %>" data-i18n-src="personal.cv_file" width="100%" height="600px"></iframe>
                  </div>
              </div>
              <% } else { %>
              <div class="cv-container">
                <p class="cv-not-available">CV non disponible pour le moment</p>
              </div>
              <% } %>
            </div>
          </section>
          <section class="skill">
            <h3 class="h3 skills-title" data-i18n="resume.skills">Mes compétences</h3>

            <ul class="skills-list content-card">
              <% for (let skill of skills) { %>
              <li class="skills-item">
                <div class="title-wrapper">
                  <h5 class="h5"><%= skill.name %></h5>
                  <data value="<%= skill.percentage %>"><%= skill.percentage %>%</data>
                </div>
                <div class="skill-progress-bg">
                  <div class="skill-progress-fill" style="width: <%= skill.percentage %>%"></div>
                </div>
              </li>
              <% } %>
            </ul>
          </section>
        </article>

        <!--
        - #PORTFOLIO
      -->

        <!-- #PORTFOLIO -->
        <article class="portfolio" data-page="portfolio">
          <header>
            <h2 class="h2 article-title" data-i18n="nav.portfolio">Portfolio</h2>
          </header>

          <section class="projects">
            <ul class="filter-list">
              <li class="filter-item">
                <button class="active" data-filter-btn data-i18n="portfolio.all">Tous</button>
              </li>
              <% for (let category of categories) { %>
              <li class="filter-item">
                <button data-filter-btn><%= category.display_name %></button>
              </li>
              <% } %>
            </ul>

            <div class="filter-select-box">
              <button class="filter-select" data-select>
                <div class="select-value" data-selecct-value data-i18n="portfolio.select_category">
                  Sélectionner une catégorie
                </div>
                <div class="select-icon">
                  <ion-icon name="chevron-down"></ion-icon>
                </div>
              </button>
              <ul class="select-list">
                <li class="select-item">
                  <button data-select-item data-i18n="portfolio.all">Tous</button>
                </li>
                <% for (let category of categories) { %>
                <li class="select-item">
                  <button data-select-item><%= category.display_name %></button>
                </li>
                <% } %>
              </ul>
            </div>

            <ul class="project-list" id="portfolio-project-list">
              <% for (let project of formattedPortfolioProjects) { %>
              <li class="project-item" data-filter-item data-category="<%= project.filterCategory || project.category.toLowerCase() %>">
                <a href="#" data-project-item>
                  <figure class="project-img">
                    <div class="project-item-icon-box">
                      <ion-icon name="eye-outline"></ion-icon>
                    </div>
                    <img src="<%= project.image %>" alt="<%= project.title %>" loading="lazy" data-project-image>
                  </figure>
                  <h3 class="project-title" data-project-title data-i18n="project_<%= project.id %>_title"><%= project.title %></h3>
                  <p class="project-category" data-project-category><%= project.category %></p>
                  
                  <!-- Données pour la modal -->
                  <div style="display: none;">
                    <span data-project-description data-i18n="project_<%= project.id %>_description"><%= project.description %></span>
                    <span data-project-repo-link><%= project.repoLink || '' %></span>
                    <span data-project-live-link><%= project.liveLink || '' %></span>
                  </div>
                </a>
              </li>
              <% } %>
            </ul>

            <!-- Pagination controls -->
            <div class="pagination-container" id="portfolio-pagination" style="display: none; text-align: center; margin-top: 30px;">
              <button class="form-btn" id="portfolio-load-more" style="margin: 0 auto; display: inline-flex;">
                <ion-icon name="add-circle-outline"></ion-icon>
                <span data-i18n="portfolio.load_more">Voir plus de projets</span>
              </button>
            </div>

          </section>
        </article>

        <!--
        - #BLOG
      -->

        <article class="blog" data-page="blog">
          <header>
            <h2 class="h2 article-title" data-i18n="nav.blog">Blog</h2>
          </header>

          <section class="blog-posts">
            <ul class="blog-posts-list" id="blog-posts-list">
              <% 
              const calculateReadingTime = (text) => {
                if (!text) return '1 min de lecture';
                const words = text.replace(/<[^>]*>/g, '').trim().split(/\s+/).filter(Boolean).length;
                const minutes = Math.max(1, Math.ceil(words / 200));
                return `${minutes} min de lecture`;
              };
              for (let blog of blogs) { 
              %>
              <li class="blog-post-item" data-blog-item>
                <a href="/blog/<%= encodeURI(blog.slug) %>">
                  <figure class="blog-banner-box">
                    <img src="<%= blog.image %>" alt="<%= blog.title %>" loading="lazy">
                  </figure>
                  <div class="blog-content">
                    <div class="blog-meta">
                      <p class="blog-category"><%= blog.category %></p>
                      <span class="dot"></span>
                      <time datetime="<%= blog.date %>"><%= blog.date %></time>
                      <span class="dot"></span>
                      <span><%= calculateReadingTime(blog.content || blog.excerpt) %></span>
                    </div>
                    <h3 class="h3 blog-item-title" data-i18n="blog_<%= blog.id %>_title"><%= blog.title %></h3>
                    <p class="blog-text" data-i18n="blog_<%= blog.id %>_excerpt"><%= blog.excerpt %></p>
                  </div>
                </a>
              </li>
              <% } %>
            </ul>

            <!-- Pagination controls -->
            <div class="pagination-container" id="blog-pagination" style="display: none; text-align: center; margin-top: 30px;">
              <button class="form-btn" id="blog-load-more" style="margin: 0 auto; display: inline-flex;">
                <ion-icon name="add-circle-outline"></ion-icon>
                <span data-i18n="blog.load_more">Charger plus d'articles</span>
              </button>
            </div>
          </section>>
          </section>
        </article>

        <!--
        - #CONTACT
      -->
        <article class="contact" data-page="contact">
          <header>
            <h2 class="h2 article-title" data-i18n="nav.contact">Contact</h2>
          </header>

          <section class="mapbox" data-mapbox>
            <figure>
              <% if (formattedPersonalInfo.location) { %>
              <iframe
                  src="https://maps.google.com/maps?q=<%= encodeURIComponent(formattedPersonalInfo.location) %>&t=&z=13&ie=UTF8&iwloc=&output=embed"
                  width="400"
                  height="300"
                  loading="lazy"
                  style="border:0;"
                  allowfullscreen="">
              </iframe>
              <% } %>
            </figure>
          </section>

          <section class="contact-form">
            <h3 class="h3 form-title" data-i18n="contact.title">Formulaire de Contact</h3>
            <p class="contact-reassurance" data-i18n="contact.reassurance">
              Réponse sous 24h ouvrées. Ton message reste confidentiel et n'est jamais partagé.
            </p>

            <form action="/api/send-email" method="POST" class="form" data-form>
              <div class="input-wrapper">
                <input
                  type="text"
                  name="fullname"
                  class="form-input"
                  placeholder="Ton nom"
                  data-i18n-placeholder="contact.name_placeholder"
                  required
                  data-form-input
                />

                <input
                  type="email"
                  name="email"
                  class="form-input"
                  placeholder="Adresse e-mail"
                  data-i18n-placeholder="contact.email_placeholder"
                  required
                  data-form-input
                />
              </div>

              <textarea
                name="message"
                class="form-input"
                placeholder="Ton message ici..."
                data-i18n-placeholder="contact.message_placeholder"
                required
                data-form-input
              ></textarea>

              <div class="h-captcha" data-sitekey="" id="hcaptcha-widget"></div>

              <button class="form-btn" type="submit" data-form-btn>
                <ion-icon name="paper-plane"></ion-icon>
                <span data-i18n="contact.send">Envoyer le message</span>
              </button>
            </form>
          </section>
        </article>

        <!-- Modal pour les projets (déplacée ici pour être globale) -->
        <div class="project-modal-container" data-project-modal-container>
          <div class="project-overlay" data-project-overlay></div>

          <section class="project-modal">
            <button
              class="project-modal-close-btn"
              data-project-modal-close-btn
            >
              <ion-icon name="close-outline"></ion-icon>
            </button>

            <div class="project-modal-content">
              <!-- Image principale -->
              <div class="project-modal-img-wrapper">
                <img
                  src=""
                  alt=""
                  data-project-modal-img
                  class="project-modal-image"
                />
              </div>

              <!-- Informations du projet -->
              <div class="project-modal-info">
                <h3 class="project-modal-title" data-project-modal-title>
                  Projet
                </h3>
                <p
                  class="project-modal-category"
                  data-project-modal-category
                >
                  Catégorie
                </p>

                <div
                  class="project-modal-description"
                  data-project-modal-description
                >
                  <p>Sélectionne un projet pour voir sa description détaillée.</p>
                </div>

                <!-- Liens d'action -->
                <div
                  class="project-modal-actions"
                  data-project-modal-actions
                >
                  <!-- Les liens seront ajoutés dynamiquement -->
                </div>
              </div>
            </div>
          </section>
        </div>

      </div>
    </main>
    <!--
    - custom js link
  -->
