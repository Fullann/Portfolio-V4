NODE_ENV=development
PORT=3000
JWT_SECRET=votre-secret-jwt-tres-securise-et-unique-min-32-chars

# Base de données MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=votre_mot_de_passe_mysql
DB_NAME=portfolio
DB_PORT=3306

# Email (Nodemailer)
EMAIL_USER=noreply@votre-domaine.ch
EMAIL_PASS=votre_mot_de_passe_email

# CORS (laisser vide en développement, mettre votre domaine en production)
CORS_ORIGIN=https://votre-domaine.ch

# URL de base du site (utilisée pour les meta OG, sitemap, etc.)
BASE_URL=http://localhost:3000

# OAuth2 Nextcloud (pour la connexion admin)
NEXTCLOUD_URL=https://votre-nextcloud.com
NEXTCLOUD_CLIENT_ID=votre_client_id
NEXTCLOUD_CLIENT_SECRET=votre_client_secret
NEXTCLOUD_ADMIN_USER=votre_identifiant_nextcloud_autorise

# hCaptcha (pour le formulaire de contact)
HCAPTCHA_SECRET=votre_secret_hcaptcha